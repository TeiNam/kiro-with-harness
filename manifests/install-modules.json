{
  "version": 1,
  "target": "kiro",
  "modules": [
    {
      "id": "steering-global",
      "description": "Universal rules — always inclusion: git-workflow. Manual (#keyword) inclusion: patterns, performance (task-specific, demoted from always for token efficiency). Applicable to any task: coding, writing, research",
      "sources": [
        { "from": "rules/common/git-workflow.md", "template": "steering-always" },
        { "from": "rules/common/patterns.md", "output": "patterns.md", "inclusion": "manual" },
        { "from": "rules/common/performance.md", "output": "performance.md", "inclusion": "manual" }
      ],
      "outputDir": ".kiro/steering",
      "defaultInstall": false
    },
    {
      "id": "hooks-global",
      "description": "Universal Kiro hooks — post-task review, pre-write guard, spec task verification, repeated-lesson capture (self-evolution)",
      "hooks": [
        { "id": "review-on-stop", "name": "Post-Task Review", "event": "agentStop", "action": "askAgent", "prompt": "Briefly review the completed work: 1) any security issues 2) proper error handling 3) no leftover console.log 4) tests needed for changes. Report issues only." },
        { "id": "pre-write-guard", "name": "Pre-Write Guard", "event": "preToolUse", "toolTypes": ["write"], "action": "askAgent", "prompt": "Before this write, check ALL of the following in one pass:\n1. SIZE — If the content exceeds 800 lines, BLOCK the write. Split into focused modules under 400 lines.\n2. SECRETS — No hardcoded API keys, tokens, passwords, or connection strings. Use env vars.\n3. DOC LOCATION — If creating a .md or .txt file outside docs/, .kiro/, README.md, CONTRIBUTING.md, CHANGELOG.md, or LICENSE, warn that docs should go in docs/.\nOnly report issues found. If all checks pass, proceed silently." },
        { "id": "test-after-task", "name": "Test After Spec Task", "event": "postTaskExecution", "action": "askAgent", "prompt": "A spec task was completed. Check if there are relevant test files for the changed code. If tests exist, run them using the project's test command. If no tests exist, suggest what tests should be written." },
        { "id": "capture-lessons", "name": "Capture Repeated Lessons", "event": "agentStop", "action": "askAgent", "prompt": "이번 작업에서 반복 가능한 교정 사항(동일 유형의 리뷰 지적, 빌드 실패 패턴, 사용자 정정)이 있었는지 식별하라. 있다면 .kiro/steering/lessons-learned.md에 추가할 한 줄 교훈을 제안하라. 사용자 자산을 수정하기 전 반드시 사용자 확인을 받고, 변경 내역을 추적 가능하게 남겨라. 교훈이 없으면 조용히 종료하라." }
      ],
      "outputDir": ".kiro/hooks",
      "defaultInstall": false
    },
    {
