    {
      "id": "hooks-core",
      "description": "Essential Kiro hooks — pre-write guard, post-write cleanup check",
      "hooks": [
        { "id": "pre-write-guard", "name": "Pre-Write Guard", "event": "preToolUse", "toolTypes": ["write"], "action": "askAgent", "prompt": "Before this write, check ALL of the following in one pass:\n1. SIZE — If the content exceeds 800 lines, BLOCK the write. Split into focused modules under 400 lines.\n2. SECRETS — No hardcoded API keys, tokens, passwords, or connection strings. Use env vars.\n3. DOC LOCATION — If creating a .md or .txt file outside docs/, .kiro/, README.md, CONTRIBUTING.md, CHANGELOG.md, or LICENSE, warn that docs should go in docs/.\nOnly report issues found. If all checks pass, proceed silently." },
        { "id": "post-write-cleanup", "name": "Post-Write Cleanup Check", "event": "postToolUse", "toolTypes": ["write"], "action": "askAgent", "prompt": "Briefly check the file just written for: 1) any console.log/print statements left for debugging (flag for removal — ignore console.error/console.warn/logger calls), 2) commented-out code blocks that should be removed. Only report if issues are found. Do not report on test files." }
      ],
      "outputDir": ".kiro/hooks",
      "defaultInstall": true
    },
    {
      "id": "hooks-quality",
      "description": "Quality Kiro hooks — diagnostics, code review, spec task verification, repeated-lesson capture (self-evolution)",
      "hooks": [
        { "id": "diagnostics-on-save", "name": "Diagnostics After Code Edit", "event": "fileEdited", "patterns": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.py", "*.go", "*.rs", "*.java", "*.kt"], "action": "askAgent", "prompt": "A code file was edited. Use getDiagnostics to check for compile errors, lint errors, and type errors. Report any issues found concisely. Do NOT use executeBash or terminal." },
        { "id": "review-on-stop", "name": "Post-Task Code Review", "event": "agentStop", "action": "askAgent", "prompt": "Briefly review the completed work: 1) any security issues 2) proper error handling 3) no leftover console.log 4) tests needed for changes. Report issues only." },
        { "id": "test-after-task", "name": "Test After Spec Task", "event": "postTaskExecution", "action": "askAgent", "prompt": "A spec task was completed. Check if there are relevant test files for the changed code. If tests exist, run them using the project's test command. If no tests exist, suggest what tests should be written." },
        { "id": "pre-task-plan", "name": "Pre-Task Planning", "event": "preTaskExecution", "action": "askAgent", "prompt": "Before starting this spec task, briefly verify: 1) Are all dependencies from previous tasks completed? 2) Are the acceptance criteria clear? 3) What files will likely need changes? List the plan in 3-5 bullet points, then proceed." },
        { "id": "capture-lessons", "name": "Capture Repeated Lessons", "event": "agentStop", "action": "askAgent", "prompt": "이번 작업에서 반복 가능한 교정 사항(동일 유형의 리뷰 지적, 빌드 실패 패턴, 사용자 정정)이 있었는지 식별하라. 있다면 .kiro/steering/lessons-learned.md에 추가할 한 줄 교훈을 제안하라. 사용자 자산을 수정하기 전 반드시 사용자 확인을 받고, 변경 내역을 추적 가능하게 남겨라. 교훈이 없으면 조용히 종료하라." }
      ],
      "outputDir": ".kiro/hooks",
      "defaultInstall": false
    },
    {
      "id": "hooks-guardrails",
      "description": "Guardrail Kiro hooks — shell safety, destructive operation warnings",
      "hooks": [
        { "id": "pre-shell-guard", "name": "Pre-Shell Safety Check", "event": "preToolUse", "toolTypes": ["shell"], "action": "askAgent", "prompt": "Before this shell command, check:\n1. DESTRUCTIVE — Does it delete files (rm -rf), drop databases, or modify production resources? If yes, BLOCK and ask for confirmation.\n2. LONG-RUNNING — Is it a dev server, watch mode, or interactive command that won't terminate? If yes, BLOCK and suggest using background process or manual execution.\n3. SIDE EFFECTS — Does it install global packages, modify system config, or push to remote? If yes, warn the user.\nOnly report issues found. If all checks pass, proceed silently." },
        { "id": "post-shell-review", "name": "Post-Shell Error Check", "event": "postToolUse", "toolTypes": ["shell"], "action": "askAgent", "prompt": "Check the shell command result. If the exit code is non-zero or stderr contains errors: 1) Summarize the error in one line, 2) Suggest a fix. If the command succeeded, proceed silently." },
        { "id": "new-file-scaffold", "name": "New File Standards Check", "event": "fileCreated", "patterns": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.py", "*.go", "*.rs", "*.java", "*.kt"], "action": "askAgent", "prompt": "A new code file was created. Verify it follows project conventions: 1) Proper file header/imports structure, 2) Consistent naming with existing files in the same directory, 3) Exports are properly defined if it's a module. Only report issues — do not modify the file." },
        { "id": "changelog-readme-before-push", "name": "Update CHANGELOG & README before push", "event": "preToolUse", "toolTypes": ["shell", ".*push.*"], "action": "askAgent", "prompt": "이 도구 실행이 원격 푸시(git push 또는 GitKraken 등 MCP push 도구)인지 먼저 판별하라. 푸시가 아니면 아무 작업도 하지 말고 즉시 진행하라(보고 생략).\n\n푸시가 맞다면, 푸시가 실행되기 전에 다음을 수행하라:\n1. 푸시될 변경을 확인한다: git log @{push}..HEAD --oneline (실패 시 git log origin/<현재브랜치>..HEAD) 와 git diff --stat 로 범위 파악.\n2. 푸시될 신규 커밋이 없으면 그대로 진행한다.\n3. CHANGELOG.md — 저장소 루트에 없으면 'Keep a Changelog' 형식으로 생성하고, 있으면 최상단 ## [Unreleased] 섹션에 이번 변경을 Added/Changed/Fixed/Removed로 분류해 한국어 요약 항목으로 추가한다.\n4. README.md(있으면 README-KR.md도 함께) — 이번 변경으로 부정확해진 수치·기능·CLI 설명만 갱신한다. 이미 정확하면 건드리지 않는다.\n5. 문서를 변경했다면 스테이징 후 별도 커밋(docs: update CHANGELOG and README)으로 남긴다. 기존 커밋을 amend하지 말 것.\n6. 문서가 이미 최신이면 변경 없이 진행한다.\n\n루프 방지: 이 훅으로 발생한 후속 push 검사에서 이미 이번 변경에 맞춰 갱신했다면 반복하지 말고 진행하라." }
      ],
      "outputDir": ".kiro/hooks",
      "defaultInstall": false
    },
