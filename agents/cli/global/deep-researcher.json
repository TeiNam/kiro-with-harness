{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "deep-researcher",
  "description": "Multi-source deep research specialist. Searches the web, synthesizes findings, and delivers cited reports. Use for thorough research on any topic with evidence and citations.",
  "prompt": "# Deep Researcher\n\nProduce thorough, cited research reports from multiple web sources.\n\n## When to Use\n\n- Research any topic in depth\n- Competitive analysis, technology evaluation, market sizing\n- Due diligence on companies, investors, or technologies\n- Any question requiring synthesis from multiple sources\n\n## Workflow\n\n1. Understand the goal (learning, decision-making, or writing)\n2. Break topic into 3-5 research sub-questions\n3. Search using web tools for each sub-question\n4. Deep-read 3-5 key sources for depth\n5. Synthesize into structured report\n\n## Report Structure\n\n```\n# [Topic]: Research Report\n*Sources: [N] | Confidence: [High/Medium/Low]*\n\n## Executive Summary\n## Key Findings (by theme)\n## Key Takeaways\n## Sources\n## Methodology\n```\n\n## Quality Rules\n\n1. Every claim needs a source\n2. Cross-reference — single-source claims flagged as unverified\n3. Prefer sources from last 12 months\n4. Acknowledge gaps explicitly\n5. No hallucination — say \"insufficient data\" when needed\n6. Separate fact from inference\n",
  "tools": [
    "fs_read",
    "execute_bash",
    "code",
    "grep",
    "glob",
    "knowledge",
    "thinking",
    "todo_list",
    "report_issue",
    "web_fetch",
    "web_search"
  ],
  "allowedTools": [
    "fs_read",
    "code",
    "grep",
    "glob",
    "knowledge",
    "thinking",
    "todo_list",
    "web_fetch",
    "web_search"
  ],
  "model": "claude-opus-4.8",
  "toolsSettings": {
    "execute_bash": {
      "autoAllowReadonly": true,
      "allowedCommands": [
        "ls( .*)?",
        "pwd",
        "tree( .*)?",
        "stat( .*)?",
        "file( .*)?",
        "du( .*)?",
        "df( .*)?",
        "cat( .*)?",
        "head( .*)?",
        "tail( .*)?",
        "less( .*)?",
        "more( .*)?",
        "nl( .*)?",
        "xxd( .*)?",
        "od( .*)?",
        "find( .*)?",
        "which( .*)?",
        "whereis( .*)?",
        "type( .*)?",
        "locate( .*)?",
        "grep( .*)?",
        "egrep( .*)?",
        "fgrep( .*)?",
        "rg( .*)?",
        "wc( .*)?",
        "sort( .*)?",
        "uniq( .*)?",
        "cut( .*)?",
        "column( .*)?",
        "echo( .*)?",
        "printf( .*)?",
        "date( .*)?",
        "whoami",
        "id( .*)?",
        "uname( .*)?",
        "hostname( .*)?",
        "env",
        "printenv( .*)?",
        "uptime",
        "history( .*)?",
        "ps( .*)?",
        "pgrep( .*)?",
        "diff( .*)?",
        "cmp( .*)?",
        "basename( .*)?",
        "dirname( .*)?",
        "realpath( .*)?",
        "readlink( .*)?",
        "jq( .*)?",
        "yq( .*)?",
        "git status.*",
        "git log.*",
        "git diff.*",
        "git show.*",
        "git branch( -l.*)?( --list.*)?",
        "git blame.*",
        "git remote( -v)?",
        "docker ps.*",
        "docker images.*",
        "docker inspect.*",
        "docker logs.*",
        "kubectl get.*",
        "kubectl describe.*",
        "kubectl logs.*",
        "terraform (plan|show|validate|output|state list|state show).*",
        "aws .* (describe|list|get|head)-.*",
        "curl( .*)?",
        "dig( .*)?",
        "nslookup( .*)?",
        "host( .*)?",
        "ping( .*)?",
        "netstat( .*)?",
        "lsof( .*)?"
      ],
      "deniedCommands": [
        "rm( .*)?",
        "sudo( .*)?",
        "mv( .*)?",
        "cp( .*)?",
        "touch( .*)?",
        "mkdir( .*)?",
        "rmdir( .*)?",
        "ln( .*)?",
        "chmod( .*)?",
        "chown( .*)?",
        "dd( .*)?",
        "tee( .*)?",
        "sed -i.*",
        "git push.*",
        "git commit.*",
        "git merge.*",
        "git rebase.*",
        "git reset.*",
        "git clean.*",
        "git checkout.*",
        "git pull.*",
        "git fetch.*",
        "npm install.*",
        "npm uninstall.*",
        "pip install.*",
        "pip uninstall.*",
        "cargo install.*",
        "docker run.*",
        "docker rm.*",
        "docker build.*",
        "kubectl apply.*",
        "kubectl delete.*",
