# MCP Proxy 시크릿 — 이 파일을 `.env` 로 복사한 뒤 값을 채운다 (cp .env.example .env).
# `.env` 는 .gitignore 에 있어 커밋되지 않는다. 실제 키를 이 example 파일에 넣지 말 것.
#
# 대안(권장): 값을 여기 두지 않고 셸 프로필(~/.zshrc 또는 ~/.bashrc)에 export 해도 된다.
# docker-compose.yaml 이 ${VAR:-} 로 셸 환경변수를 그대로 주입한다. 예:
#   echo 'export BRAVE_API_KEY="발급받은_키"' >> ~/.zshrc && source ~/.zshrc
# 이 방식은 프록시를 안 거치고 클라이언트가 직접 띄우는 stdio 서버에도 같은 키가 공유되는 장점이 있다.

# api.search.brave.com/app/keys (무료 2,000 쿼리/월)
BRAVE_API_KEY=
# github.com/settings/personal-access-tokens — GitHub MCP 원격 엔드포인트 인증용
GITHUB_PAT=
# Obsidian Local REST API 플러그인 설정에서 발급
OBSIDIAN_API_KEY=
